                    "type": "string"
                  },
                  "assigned_to": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "string",
                    "description": "Low, Medium, High, Urgent"
                  },
                  "due_date": {
                    "type": "string",
                    "description": "Due date (YYYY-MM-DD)"
