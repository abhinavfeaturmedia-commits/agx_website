                  },
                  "client_name": {
                    "type": "string",
                    "description": "Client name"
                  },
                  "service_type": {
                    "type": "string",
                    "description": "Custom AI Agent, Automation, etc."
                  },
                  "project_value": {
                    "description": "Total value in INR (Accepts number or currency string e.g. 200000 or \"₹2,00,000\")",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "due_date": {
                    "type": "string",
                    "description": "Due date (YYYY-MM-DD)"
                  },
                  "project_manager": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created project details"
          }
        }
      }
    },
    "/api/tools/update_project": {
      "post": {
        "summary": "Update project progress %, status, delivery date, or PM",
        "operationId": "updateProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "description": "Project title"
                  },
                  "status": {
                    "type": "string",
                    "description": "PLANNING, IN PROGRESS, TESTING, CLIENT REVIEW, COMPLETED"
                  },
                  "progress": {
                    "type": "number",
                    "description": "Completion % (0 to 100)"
                  },
                  "due_date": {
                    "type": "string"
                  },
                  "project_manager": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project details"
          }
        }
