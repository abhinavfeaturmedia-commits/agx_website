                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string",
                    "description": "Task title to match"
                  },
                  "status": {
                    "type": "string",
                    "description": "TO DO, IN PROGRESS, IN REVIEW, COMPLETED, BLOCKED"
                  },
                  "actual_hours": {
                    "type": "number"
                  },
                  "assigned_to": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
