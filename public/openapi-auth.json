{
  "openapi": "3.1.0",
  "info": {
    "title": "AGX CRM Cloud AI API",
    "description": "24/7 Cloud API for managing AGX CRM leads, clients, projects, tasks, calendar events, finance, issues, vault, and partners directly through conversational AI on ChatGPT, Claude, and Gemini.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://agxperience.netlify.app",
      "description": "Production Netlify Cloud Server (24/7 Available)"
    }
  ],
  "components": {
    "schemas": {},
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    },
    {}
  ],
  "paths": {
    "/api/tools/get_daily_briefing": {
      "post": {
        "summary": "10-second morning briefing on urgent tasks, follow-ups, and receivables",
        "operationId": "getDailyBriefing",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Daily briefing summary"
          }
        }
      }
    },
    "/api/tools/get_financial_summary": {
      "post": {
        "summary": "Total invoiced, collected revenue, outstanding balances, and margin",
        "operationId": "getFinancialSummary",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Financial summary report"
          }
        }
      }
    },
    "/api/tools/search_leads": {
      "post": {
        "summary": "Search leads by name, company, email, phone, or status",
        "operationId": "searchLeads",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Search term across name, company, email, or phone"
                  },
                  "status": {
                    "type": "string",
                    "description": "NEW, CONTACTED, QUALIFIED, PROPOSAL SENT, NEGOTIATION, WON, LOST"
                  },
                  "priority": {
                    "type": "string",
                    "description": "Low, Medium, High, Urgent"
                  },
                  "limit": {
                    "type": "number",
                    "description": "Max results to return"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of matching leads"
          }
        }
      }
    },
    "/api/tools/create_lead": {
      "post": {
        "summary": "Create a new prospect/lead in AGX CRM with contact details and deal value",
        "operationId": "createLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Contact person full name"
                  },
                  "company": {
                    "type": "string",
                    "description": "Company name"
                  },
                  "phone": {
                    "type": "string",
                    "description": "Phone number"
                  },
                  "email": {
                    "type": "string",
                    "description": "Email address"
                  },
                  "location": {
                    "type": "string",
                    "description": "City or country"
                  },
                  "interested_service": {
                    "type": "string",
                    "description": "Service interest (e.g. AI Automation, Web App)"
                  },
                  "estimated_deal_value": {
                    "description": "Estimated commercial deal value in INR (Accepts number or currency string e.g. 200000 or \"₹2,00,000\")",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "description": "Low, Medium, High, Urgent"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Initial conversation summary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created lead details"
          }
        }
      }
    },
    "/api/tools/update_lead": {
      "post": {
        "summary": "Move deal across pipeline stages (NEW -> QUALIFIED -> WON) and set follow-ups",
        "operationId": "updateLead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Lead UUID"
                  },
                  "name": {
                    "type": "string",
                    "description": "Lead contact or company name"
                  },
                  "status": {
                    "type": "string",
                    "description": "NEW, CONTACTED, QUALIFIED, PROPOSAL SENT, NEGOTIATION, WON, LOST"
                  },
                  "estimated_deal_value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "priority": {
                    "type": "string",
                    "description": "Low, Medium, High, Urgent"
                  },
                  "next_follow_up": {
                    "type": "string",
                    "description": "ISO date for next scheduled follow-up"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Status update notes"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated lead details"
          }
        }
      }
    },
    "/api/tools/log_lead_activity": {
      "post": {
        "summary": "Log a call, WhatsApp message, meeting summary, or note for a lead",
        "operationId": "logLeadActivity",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "notes"
                ],
                "properties": {
                  "lead_id": {
                    "type": "string"
                  },
                  "lead_name": {
                    "type": "string"
                  },
                  "activity_type": {
                    "type": "string",
                    "description": "Call, WhatsApp, Email, Meeting, Note, Status Change"
                  },
                  "notes": {
                    "type": "string",
                    "description": "Conversation summary"
                  },
                  "set_next_follow_up": {
                    "type": "string",
                    "description": "Optional ISO date for next touchpoint"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity logged confirmation"
          }
        }
      }
    },
    "/api/tools/convert_lead_to_client": {
      "post": {
        "summary": "Deal Won pipeline: convert lead to client, start project, and assign onboarding tasks",
        "operationId": "convertLeadToClient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lead_id": {
                    "type": "string"
                  },
                  "lead_name": {
                    "type": "string",
                    "description": "Lead name to convert"
                  },
                  "project_name": {
                    "type": "string",
                    "description": "Project title"
                  },
                  "project_value": {
                    "description": "Total project commercial value in INR (Accepts number or currency string e.g. 200000 or \"₹2,00,000\")",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "service_type": {
                    "type": "string",
                    "description": "Custom AI Agent, Automation, etc."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Won deal conversion report"
          }
        }
      }
    },
    "/api/tools/search_clients": {
      "post": {
        "summary": "Search client accounts, lifetime revenue, and contacts",
        "operationId": "searchClients",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Client name or company"
                  },
                  "status": {
                    "type": "string",
                    "description": "Active, Inactive, On Hold"
                  },
                  "limit": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of clients"
          }
        }
      }
    },
    "/api/tools/create_client": {
      "post": {
        "summary": "Create a new client profile",
        "operationId": "createClient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
