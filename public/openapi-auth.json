    "/api/tools/manage_milestones": {
      "post": {
        "summary": "Create or update project milestones with target deadlines and amounts",
        "operationId": "manageMilestones",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "create or update (default create)"
                  },
                  "project_name": {
                    "type": "string",
                    "description": "Project name"
                  },
                  "title": {
                    "type": "string",
                    "description": "Milestone title"
                  },
                  "amount": {
                    "description": "Commercial amount in INR (Accepts number or currency string e.g. 200000 or \"₹2,00,000\")",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "due_date": {
                    "type": "string",
                    "description": "Due date (YYYY-MM-DD)"
                  },
                  "progress": {
                    "type": "number",
                    "description": "Milestone progress % (0 to 100)"
                  },
                  "status": {
                    "type": "string",
                    "description": "Pending, In Progress, Completed"
                  },
                  "is_invoiced": {
                    "type": "boolean",
                    "description": "Whether milestone has been billed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Milestone details"
          }
        }
      }
    },
    "/api/tools/get_tasks": {
