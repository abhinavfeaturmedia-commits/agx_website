            "description": "Updated task details"
          }
        }
      }
    },
    "/api/tools/manage_invoices": {
      "post": {
        "summary": "Create milestone invoices, list existing invoices, or chase overdue collections",
        "operationId": "manageInvoices",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "create, list, or get_overdue (default create if amount provided, else list)"
                  },
                  "client_name": {
                    "type": "string",
                    "description": "Client name"
                  },
                  "amount": {
                    "description": "Invoice subtotal amount in INR (Accepts number or currency string e.g. 200000 or \"₹2,00,000\")",
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ]
                  },
                  "due_days": {
                    "type": "number",
                    "description": "Days until due (default 14)"
                  },
                  "status": {
                    "type": "string",
                    "description": "Filter by Draft, Sent, Paid, Partially Paid, Overdue"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice report or created invoice details"
          }
        }
      }
    },
