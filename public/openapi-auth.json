                  },
                  "priority": {
                    "type": "string",
                    "description": "Low, Medium, High, Urgent"
                  },
                  "assigned_to": {
                    "type": "string"
                  },
                  "due_today": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of tasks"
          }
        }
      }
    },
