    "/api/tools/update_client": {
      "post": {
        "summary": "Update client profile details, address, tax ID, phone, or status",
        "operationId": "updateClient",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string",
                    "description": "Client contact or company name to search"
                  },
                  "company": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "gst_tax_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "description": "Active, Inactive, On Hold"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated client details"
          }
        }
      }
    },
    "/api/tools/list_projects": {
