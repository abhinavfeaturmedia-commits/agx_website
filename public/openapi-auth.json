                  },
                  "client_name": {
                    "type": "string"
                  },
                  "project_manager": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of projects"
          }
        }
      }
    },
    "/api/tools/create_project": {
      "post": {
        "summary": "Create a new client project with budget and deadline",
        "operationId": "createProject",
        "requestBody": {
