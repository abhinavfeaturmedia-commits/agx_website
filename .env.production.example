# ============================================================================
# AGX Production Environment Configuration for Hostinger
# Target Domain: agxperience.com
# ============================================================================

# Server Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Hostinger Native MySQL Database Configuration
# Find these credentials in Hostinger hPanel -> Databases -> MySQL Databases
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_agxdb
DB_USER=u123456789_agxuser
DB_PASSWORD=your_secure_mysql_password_here
DB_CONNECTION_LIMIT=10

# Security & Session Authentication
JWT_SECRET=agx_super_secure_jwt_random_key_replace_this_with_random_string

# Website URL & Public Metadata
SITE_URL=https://agxperience.com
VITE_SITE_URL=https://agxperience.com
