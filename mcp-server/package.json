{
  "name": "agx-crm-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for AGX CRM - connect Claude, ChatGPT, Gemini, and Cursor directly to your CRM database.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http-server.ts",
    "start:http": "node dist/http-server.js",
    "test:tools": "tsx src/test-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
